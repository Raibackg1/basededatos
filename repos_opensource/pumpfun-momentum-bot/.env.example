# Copie para .env e preencha.
LIVE_RPC=https://mainnet.helius-rpc.com/?api-key=cole_sua_chave_helius

# stream de trades (exige key com saldo minimo)
PUMPPORTAL_API_KEY=cole_sua_chave_pumpportal
STREAM_WALLET=pubkey_da_carteira_do_stream

# execucao real (carteira dedicada, saldo baixo)
LIVE_SEED_PHRASE=suas doze palavras da seed aqui
EXEC_WALLET=pubkey_da_carteira_de_execucao

# parametros opcionais do bot
TS_LIVE_MAX_POSITIONS=10
