{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "lastUpdated": "2026-10-13T02:53:43.427Z",
  "description": "Registro persistente de memoria para PumpScope. Almacena configuraciones evaluadas, resultados auditados y patrones prohibidos. ACTUALIZADO 2026-10-12: el slippage dejo de ser una constante inventada (BP-013), se filtran snapshots corruptos (BP-014), y toda busqueda exige Deflated EV + validacion cross-fitted (BP-015/BP-016).",
  "bannedPatterns": [
    {
      "id": "BP-001",
      "name": "Stop-Loss Nominal Ilusorio en Micro-Cap",
      "rule": "Asumir SL <= -10% sin modelar caída por slippage a -33% en Pump.fun",
      "status": "FORBIDDEN",
      "reason": "La liquidez se evapora al vender en pánico; pérdida promedio real registrada fue -33.49%."
    },
    {
      "id": "BP-002",
      "name": "Entrada Tardía en Techo de Curva (ATH Dump Trap)",
      "rule": "Exigir holders >= 30 Y netBuyers >= 15 con edad entre 1m y 2m",
      "status": "FORBIDDEN",
      "reason": "Compra el pico del pump inicial y absorbe el dev dump inmediato."
    },
    {
      "id": "BP-003",
      "name": "Filtro Estrangulador con Muestra N < 5",
      "rule": "Configuraciones ultra-restrictivas que filtran el 99.9% de los tokens dejando n <= 2",
      "status": "FORBIDDEN",
      "reason": "Carece de significancia estadística; cualquier trade fallido destruye el EV reportado."
    },
    {
      "id": "BP-004",
      "name": "Sesgo de Supervivencia / Exclusión de Stops",
      "rule": "Reportar winrates o EV considerando únicamente salidas GREEN o TP",
      "status": "FORBIDDEN",
      "reason": "Oculta el 70% de pérdidas en stop-loss que convierten el balance global en negativo."
    },
    {
      "id": "BP-005",
      "name": "Concentración de Cabal / Insiders (> 30%)",
      "rule": "Entrar en tokens con más del 30% del supply en billeteras vinculadas por grafo en RugCheck",
      "status": "FORBIDDEN",
      "reason": "Riesgo de dump masivo coordinado; los insiders liquidan al primer tick alcista."
    },
    {
      "id": "BP-006",
      "name": "Trampa de Bloque 0 (Bundles / Snipers > 25%)",
      "rule": "Entrar en tokens con más del 25% del supply adquirido en el bloque de creación vía Jito bundles",
      "status": "FORBIDDEN",
      "reason": "Venta automática garantizada por bots snipers al instante de entrar liquidez retail."
    },
    {
      "id": "BP-007",
      "name": "Saturación Pre-Migración Pump.fun (> 85%)",
      "rule": "Entrar en tokens con más del 85% de la curva de bonding completada",
      "status": "FORBIDDEN",
      "reason": "Bache de liquidez severo y riesgo de congelamiento durante la migración a Raydium."
    },
    {
      "id": "BP-008",
      "name": "Creador Serial Tóxico (RUGGER)",
      "rule": "Entrar en tokens lanzados por desarrolladores con >= 3 pérdidas y Winrate < 20%",
      "status": "FORBIDDEN",
      "reason": "Probabilidad de rug pull comprobada > 94.7%; vetado de raíz por el Anti-Toxic Guard."
    },
    {
      "id": "BP-009",
      "name": "Entrada en Techo Parabólico sin Pullback (ATH Trap)",
      "rule": "Comprar tokens con impulso > 150% que coticen a >= 95% del ATH sin consolidar soporte previo",
      "status": "FORBIDDEN",
      "reason": "Absorbe la toma de ganancias de snipers y el dev dump temprano; genera salidas destructivas por STALL o SL de pánico."
    },
    {
      "id": "BP-010",
      "name": "Micro-Timeout STALL Dependiente de Polling Lento (> 30s)",
      "rule": "Asumir STALL nominal <= -5% con capturas de base de datos de 45s a 120s",
      "status": "FORBIDDEN",
      "reason": "La latencia del muestreador hace que la orden se ejecute tras el desplome total del token; la pérdida real promedio observada fue -28.93%."
    },
    {
      "id": "BP-011",
      "name": "Optimización Estocástica Ciega de Winrate con Robbins-Monro",
      "rule": "Calibrar umbrales adaptativos persiguiendo un objetivo de Winrate fijo (ej. 65%) ignorando la magnitud de las pérdidas",
      "status": "FORBIDDEN",
      "reason": "En distribuciones de cola pesada, un alto Winrate con ganancias mínimas y stops de -35% garantiza la ruina del capital."
    },
    {
      "id": "BP-012",
      "name": "Contaminación del Test Temporal por Selección Múltiple",
      "rule": "Evaluar métricas y seleccionar umbrales sobre el mismo conjunto usado para early stopping",
      "status": "FORBIDDEN",
      "reason": "Destruye la independencia out-of-sample y genera sobreajuste al holdout temporal."
    },
    {
      "id": "BP-013",
      "name": "Penalizacion de Ejecucion Inventada (no medida)",
      "rule": "Aplicar una penalizacion de panico fija (ej. 0.25) ADEMAS del precio de snapshot que ya contiene la caida del mercado",
      "status": "FORBIDDEN",
      "reason": "strategy.ts:88 hacia Math.max(base*4, 0.25). Medido: el precio observado en el trigger del SL ya estaba en -51.76% y en STALL en -23.57%. La penalizacion extra era doble contabilidad y el signo del EV dependia de esa constante (panic=0 -> +9.25%, 0.25 -> +1.86%, 0.35 -> -1.29%). Reemplazado por src/lib/fill-model.ts con evidencia declarada."
    },
    {
      "id": "BP-014",
      "name": "Snapshots de Precio Corruptos sin Filtro de Integridad",
      "rule": "Procesar series de snapshots sin descartar saltos de precio fisicamente imposibles",
      "status": "FORBIDDEN",
      "reason": "67 tokens tenian saltos >20x entre snapshots consecutivos (hasta x16.000.000.000), todos desde priceUsd == 5.000e-06 (lecturas DexScreener corruptas post-migracion). Un unico trade con GREEN +63.045% decidia el EV de todas las configs. Ahora sanitizeSnaps() en src/lib/loadsim.ts descarta saltos >20x."
    },
    {
      "id": "BP-015",
      "name": "Seleccion por Maximo sin Correccion por Multiples Comparaciones",
      "rule": "Elegir la configuracion de mayor EV sobre K celdas y reportar ese EV como resultado, sin deflactarlo ni medirlo cross-fitted",
      "status": "FORBIDDEN",
      "reason": "Con K=7.776 celdas y sigma=6.84pp, el maximo esperado con EV real 0 esta +3.86 sigma = +26.4pp sobre la media. Medido: media -19.68%, maximo -0.72%. Toda busqueda debe reportar Deflated EV y validacion cross-fitted."
    },
    {
      "id": "BP-016",
      "name": "Bloque de Test Mirado mas de Una Vez",
      "rule": "Calcular metricas de test para varios candidatos y elegir el mejor",
      "status": "FORBIDDEN",
      "reason": "Convierte el test en validacion y destruye la independencia OOS. Protocolo aplicado: seleccionar en TRAIN, admitir en VAL, y el bloque de TEST lo ve UNICAMENTE el #1 de validacion."
    }
  ],
